# 复制为 .env 后填写。不要把 .env 提交进仓库。
BEEROUTE_API_KEY=
BEEROUTE_BASE_URL=https://beeroute.ai/v1

# 单点 JS 游戏生成（不改变前三步配置）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
# Node.js 不在启动服务的 PATH 中时，设置 node.exe 的绝对路径
NODE_BINARY=
BEEROUTE_MODELS=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GEMINI_API_KEY=
PORT=8765
